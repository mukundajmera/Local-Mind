# Local-Mind Backend Configuration
# =================================

# Neo4j Configuration (required even if not using graph features)
NEO4J_PASSWORD=localmind2024

# Milvus Configuration
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Upload Directory
UPLOAD_DIR=/tmp/localmind_uploads

# Database URL (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./data/localmind.db

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# LLM Configuration (Ollama - local)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2:3b
